{
  "name": "cabinet-rimbault-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "sync-schema": "cp ../cabinet-rimbault-admin/prisma/schema.prisma ./prisma/schema.prisma && npx prisma generate",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma || true",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "15.5.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.12.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "prisma": "^5.22.0",
    "typescript": "^5"
  }
}
