# --- Base de données (Supabase Postgres, partagée avec l'admin) ---
DATABASE_URL=postgresql://user:password@host:5432/postgres?pgbouncer=true&connection_limit=1

# --- API publique ---
# Doit être identique à la PUBLIC_API_KEY de l'admin tant qu'elles partagent la même clé,
# OU dédiée à l'API et configurée dans la vitrine.
PUBLIC_API_KEY=

# --- Emails (Resend) — optionnels, si absent les emails ne sont pas envoyés (warning dans les logs) ---
RESEND_API_KEY=
AGENCY_EMAIL_FROM="Cabinet Rimbault <contact@cabinet-rimbault.fr>"

# Destinataire des notifications de leads (contact + estimation).
# Si absent, on utilise l'e-mail saisi dans les paramètres de l'agence (AgencySettings.email).
# AGENCY_NOTIFICATION_EMAIL=agent@cabinet-rimbault.fr

# Gabarit d'URL de la fiche bien sur la vitrine, utilisé pour mettre un lien dans la
# notification agence. `{reference}` est remplacé par la référence du bien. Si absent : pas de lien.
# PROPERTY_PAGE_URL_TEMPLATE=https://cabinet-rimbault.fr/bien/{reference}

# --- CORS (prod) — origines autorisées additionnelles, séparées par virgules ---
# Les origines suivantes sont déjà whitelistées par défaut dans le middleware :
#   http://localhost:3000, http://localhost:3001,
#   https://cabinet-rimbault.fr, https://www.cabinet-rimbault.fr
# CORS_ALLOWED_ORIGINS=https://staging.cabinet-rimbault.fr
